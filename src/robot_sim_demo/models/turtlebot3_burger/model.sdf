<?xml version="1.0"?>
<sdf version="1.9">
  <model name="turtlebot3_burger">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <pose>0 0 0.010 0 0 0</pose>
      <inertial>
        <pose>-0.032 0 0.045 0 0 0</pose>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0120</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0120</iyy><iyz>0</iyz>
          <izz>0.0140</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>0 0 0.0425 0 0 0</pose>
        <geometry><cylinder><radius>0.089</radius><length>0.065</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>0</mu><mu2>0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="base_visual">
        <pose>-0.032 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://turtlebot3_burger/meshes/burger_base.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material>
          <ambient>0.015 0.015 0.018 1</ambient>
          <diffuse>0.04 0.04 0.05 1</diffuse>
          <specular>0.95 0.95 1.0 1</specular>
          <shininess>140</shininess>
        </material>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.08 0.033 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000047</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000082</iyy><iyz>0</iyz>
          <izz>0.000047</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.023</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.5</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1><slip1>0.0</slip1><slip2>0.01</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <geometry><mesh><uri>model://turtlebot3_burger/meshes/left_tire.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material>
          <ambient>0.01 0.01 0.012 1</ambient>
          <diffuse>0.03 0.03 0.035 1</diffuse>
          <specular>0.5 0.5 0.55 1</specular>
          <shininess>60</shininess>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.08 0.033 0 0 0</pose>
      <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.000047</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000082</iyy><iyz>0</iyz>
          <izz>0.000047</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.023</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.5</mu><mu2>1.0</mu2><fdir1>1 0 0</fdir1><slip1>0.0</slip1><slip2>0.01</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <geometry><mesh><uri>model://turtlebot3_burger/meshes/right_tire.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material>
          <ambient>0.01 0.01 0.012 1</ambient>
          <diffuse>0.03 0.03 0.035 1</diffuse>
          <specular>0.5 0.5 0.55 1</specular>
          <shininess>60</shininess>
        </material>
      </visual>
    </link>

    <link name="caster_wheel">
      <pose>-0.081 0 0.006 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0</mu><mu2>0</mu2></ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.0</friction></dynamics></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit><dynamics><damping>0.01</damping><friction>0.0</friction></dynamics></axis>
    </joint>
    <joint name="caster_wheel_joint" type="fixed">
      <parent>base_link</parent><child>caster_wheel</child>
    </joint>

    <link name="laser_link">
      <pose>-0.032 0 0.172 0 0 0</pose>
      <visual name="laser_visual">
        <geometry><mesh><uri>model://turtlebot3_burger/meshes/lds.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material>
          <ambient>0.02 0.02 0.024 1</ambient>
          <diffuse>0.05 0.05 0.06 1</diffuse>
          <specular>0.8 0.8 0.85 1</specular>
          <shininess>100</shininess>
        </material>
      </visual>
      <sensor name="laser" type="gpu_lidar">
        <always_on>true</always_on><update_rate>8</update_rate><topic>/scan</topic><gz_frame_id>laser_link</gz_frame_id><visualize>true</visualize>
        <ray><scan><horizontal><samples>240</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.03</min><max>8.0</max><resolution>0.01</resolution></range><noise><type>gaussian</type><mean>0</mean><stddev>0.002</stddev></noise></ray>
      </sensor>
    </link>
    <joint name="laser_joint" type="fixed"><parent>base_link</parent><child>laser_link</child></joint>

    <link name="camera_link">
      <pose>0.045 0 0.130 0 0 0</pose>
      <visual name="camera_visual">
        <geometry><box><size>0.025 0.050 0.025</size></box></geometry>
        <material><ambient>0.46 0.50 0.56 1</ambient><diffuse>0.68 0.73 0.80 1</diffuse><specular>0.98 0.98 1.00 1</specular><shininess>100</shininess></material>
      </visual>
      <visual name="camera_lens">
        <pose>0.014 0 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.005 0.008 0.012 1</ambient><diffuse>0.015 0.025 0.035 1</diffuse><specular>0.35 0.50 0.62 1</specular><shininess>90</shininess></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on><update_rate>4</update_rate><topic>/camera/image_raw</topic><gz_frame_id>camera_link</gz_frame_id><visualize>true</visualize>
        <camera name="front_camera"><horizontal_fov>1.0472</horizontal_fov><image><width>320</width><height>180</height><format>R8G8B8</format></image><clip><near>0.01</near><far>12.0</far></clip></camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.16</wheel_separation><wheel_radius>0.033</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>2.5</max_linear_acceleration><min_linear_acceleration>-2.5</min_linear_acceleration>
      <max_angular_acceleration>5.0</max_angular_acceleration><min_angular_acceleration>-5.0</min_angular_acceleration>
      <max_linear_velocity>10.0</max_linear_velocity><min_linear_velocity>-10.0</min_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity><min_angular_velocity>-3.0</min_angular_velocity>
    </plugin>
  </model>
</sdf>
