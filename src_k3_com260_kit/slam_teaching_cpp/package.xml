<?xml version="1.0"?>
<package format="3">
  <name>slam_teaching_cpp</name>
  <version>0.0.1</version>
  <description>COM260 C++17 numerical and ROS examples for SLAM teaching chapters 10 to 15.</description>
  <maintainer email="duoqilai@outlook.com">DuoQilai</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
