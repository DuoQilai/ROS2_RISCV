  <version>0.1.0</version>
  <description>RGB-D acquisition with a Gazebo sensor or a RealSense camera.</description>
  <maintainer email="duoqilai@outlook.com">DuoQilai</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_sim_demo</exec_depend>
