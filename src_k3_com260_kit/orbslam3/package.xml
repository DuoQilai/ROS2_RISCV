<?xml version="1.0"?>
<package format="3">
  <name>orbslam3</name><version>0.1.0</version>
  <description>Run ORB-SLAM3 with synchronized ROS 2 RGB and registered depth images.</description>
  <maintainer email="duoqilai@outlook.com">DuoQilai</maintainer>
  <license>GPL-3.0-only</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>sensor_msgs</depend><depend>geometry_msgs</depend>
  <depend>nav_msgs</depend><depend>cv_bridge</depend><depend>message_filters</depend>
  <depend>image_transport</depend>
  <depend>tf2_ros</depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>compressed_depth_image_transport</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
