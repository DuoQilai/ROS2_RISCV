Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid (1 m)
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: COM260 ORB-SLAM3 trajectory
      Topic:
        Value: /orb_slam3/trajectory
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color: 30; 180; 255
      Line Style: Lines
      Buffer Length: 1
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: EuRoC cam0 recorded input
      Topic:
        Value: /orb_slam3/image
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
  Enabled: true
  Global Options:
    Background Color: 35; 38; 44
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.1
      Target Frame: map
      Yaw: 0.5
Window Geometry:
  Height: 800
  Width: 1280
  X: 0
  Y: 0
