Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid (1 m)
      Cell Size: 1
      Plane Cell Count: 20
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: COM260 RGB-D camera trajectory
      Topic:
        Value: /orb_slam3/trajectory
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Color: 30; 180; 255
      Line Style: Lines
      Line Width: 0.025
      Buffer Length: 1
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Tracked sparse map points
      Topic:
        Value: /orb_slam3/map_points
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 200; 80
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Gazebo RGB input
      Topic:
        Value: /camera/color/image_raw
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Gazebo depth input (m)
      Topic:
        Value: /camera/aligned_depth_to_color/image_raw
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 1
      Normalize Range: false
      Min Value: 0
      Max Value: 5
      Median window: 5
  Enabled: true
  Global Options:
    Background Color: 35; 38; 44
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5.5
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Name: Current View
      Pitch: 0.5
      Target Frame: map
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1280
  X: 0
  Y: 0
