FROM localhost/ros2-course-com260:ch06-nav2

LABEL org.ros2-riscv.component="humble-gazebo-slam-control"

RUN apt-get update \
    && apt-get install -y --no-remove --no-install-recommends \
        git libgz-sim8-dev \
        ros-humble-cartographer ros-humble-cartographer-ros ros-humble-cartographer-ros-msgs \
        ros-humble-ros2-control ros-humble-diff-drive-controller ros-humble-joint-state-broadcaster \
        ros-humble-joint-state-publisher ros-humble-joint-state-publisher-gui \
        ros-humble-rosbag2 ros-humble-rqt-image-view \
    && rm -rf /var/lib/apt/lists/*

# Humble binaries target Fortress; build the official Humble plugin against Harmonic.
ARG GZ_ROS2_CONTROL_REV=392112557b08830b9c7f9bf65ab2a8325c7a85f0
ENV GZ_VERSION=harmonic
RUN mkdir -p /opt/gz_ros2_control_ws/src/gz_ros2_control \
    && cd /opt/gz_ros2_control_ws/src/gz_ros2_control \
    && git init \
    && git remote add origin https://github.com/ros-controls/gz_ros2_control.git \
    && git fetch --depth 1 origin "$GZ_ROS2_CONTROL_REV" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$GZ_ROS2_CONTROL_REV" \
    && . /opt/ros/humble/setup.sh \
    && cd /opt/gz_ros2_control_ws \
    && colcon build --packages-select gz_ros2_control --executor sequential \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf build log src
