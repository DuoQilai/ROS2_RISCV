<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <gravity>0 0 -9.8</gravity>
    <physics name="stable_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.68 0.68 0.68 1.0</ambient>
      <background>0.9 0.9 0.95 1.0</background>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://ISCAS_groundplane</uri>
    </include>

    <model name="west_wall">
      <static>true</static><pose>-4.8 0 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.2 9.8 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 9.8 1.0</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>4.8 0 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.2 9.8 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 9.8 1.0</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -4.8 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>9.8 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>9.8 0.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="north_wall">
      <static>true</static><pose>0 4.8 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>9.8 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>9.8 0.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="northwest_landmark">
      <static>true</static><pose>-3 2.5 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.6 1.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 1.0 1.0</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_landmark">
      <static>true</static><pose>1 -2 0.5 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>1.0 0.6 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.6 1.0</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
